---
import Layout from '../layouts/Layout.astro';
import { HOME, SOCIALS, SITE, PROJECTS } from '../const';
import LinkButton from '../components/LinkButton.astro';
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <section class="space-y-12">
    <div class="font-serif space-y-4">
      <h4 class="font-sans font-semibold">Hey, I'm Anatolii 👋</h4>
      <p>
        This is my playground as a frontend engineer. This site’s where I drop my thoughts, <br /> side projects, and whatever
        else I’m building or learning.
      </p>
      <p>Feel free to look around — maybe you'll find something useful.</p>
      <p>Let’s stay connected:</p>
      <div class="flex gap-x-1.5 gap-y-0.5 flex-wrap font-sans">
        {
          SOCIALS.map(social => (
            <span class="flex gap-1.5">
              <a href={social.URL} target="_blank" class="underline underline-offset-2" rel="noreferrer noopener">
                {social.NAME}
              </a>
              <span class="text-stone-800/60">/</span>
            </span>
          ))
        }
        <span class="flex gap-1.5">
          <a href={`mailto:${SITE.EMAIL}`} class="underline underline-offset-2">email</a>
        </span>
      </div>
    </div>
    <div class="font-serif space-y-4">
      <div class="flex justify-between">
        <h4 class="font-sans font-semibold">About me</h4>
        <LinkButton href="/cv">Explore CV</LinkButton>
      </div>
      <p>Frontend engineer with <b>over 7 years</b> of experience in scalable web applications.</p>
      <p>
        <b>Frontend:</b> JavaScript (ES6+), TypeScript, Vue.js (Vue 2 & Vue 3, Composition API), Nuxt.js, React, Next.js,
        Tailwind, Jest, Vitest<br />
        <b>Expertise in:</b> сode reviews, frontend application architecture, adaptive and semantic layout<br />
        <b>Other:</b> Node.js, Nest.js, Bun, Hono, REST API, GraphQL, SSR, Git, CI/CD, Docker <br />
        <b>Languages: </b> English (Intermediate), Russian (Native), Italian (Beginner)
      </p>
    </div>
    <div class="font-serif space-y-4">
      <h4 class="font-sans font-semibold">Projects</h4>
      <div class="space-y-1">
        {
          PROJECTS.map(project => (
            <a
              href={project.URL}
              class:list={[
                'group block px-3 py-2.5 rounded-md text-stone-800 hover:text-stone-800',
                'transition-colors duration-300 ease-in-out bg-stone-800/5 hover:bg-stone-800/10',
              ]}
            >
              <span class="font-sans font-medium inline-flex items-center gap-1.5">
                {project.NAME}
                <span class="text-stone-400 transition-transform duration-300 ease-in-out group-hover:translate-x-0.5">
                  →
                </span>
              </span>
              <span class="block text-sm text-stone-500 mt-0.5">{project.DESCRIPTION}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
